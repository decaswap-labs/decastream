#!/bin/bash

# Run DAI tests with automatic chunking
# Usage: ./test-dai [chunk-size] [output-file]

CHUNK_SIZE=${1:-10}
OUTPUT_FILE=${2:-"test-results-dai-$(date +%Y%m%d_%H%M%S).json"}

echo "🧪 Running DAI trade tests with chunking..."
echo "📦 Chunk size: $CHUNK_SIZE tokens"
echo "📁 Output: $OUTPUT_FILE"
echo ""

# Get DAI pair count from JSON file
DAI_COUNT=$(jq '.totalCount' config/dai_pairs_clean.json)

echo "📊 Detected DAI pairs: $DAI_COUNT"
echo ""

# Temporary file for all logs
TEMP_LOG=$(mktemp)

# Function to run test for DAI with chunking
run_chunked_test() {
    local token=$1
    local count=$2
    local test_name=$3
    
    local num_chunks=$(( (count + CHUNK_SIZE - 1) / CHUNK_SIZE ))
    
    echo "🔄 Testing $token in $num_chunks chunks..."
    
    for ((chunk=0; chunk<num_chunks; chunk++)); do
        local start=$((chunk * CHUNK_SIZE))
        local end=$((start + CHUNK_SIZE))
        if [ $end -gt $count ]; then
            end=$count
        fi
        
        echo "   Chunk $((chunk+1))/$num_chunks: tokens $start-$end"
        START_INDEX=$start END_INDEX=$end forge test --match-test "$test_name" -vv 2>&1 | tee -a "$TEMP_LOG"
    done
}

# Run tests for DAI
run_chunked_test "DAI" $DAI_COUNT "test_PlaceTradeWithDAITokens"

echo ""
echo "📊 Extracting results..."

# Extract results from logs
bash ./scripts/extract-events-to-json.sh "$OUTPUT_FILE" < "$TEMP_LOG"

# Cleanup
rm -f "$TEMP_LOG"

echo ""
echo "✅ DAI tests completed!"
echo "📊 Results saved to: $OUTPUT_FILE"
